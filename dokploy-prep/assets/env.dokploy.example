# ШАБЛОН .env.dokploy.example. Адаптируй под проект.
#
# НЕ коммить заполненный файл. Значения вставляются в Dokploy →
# сервис → Environment одним блоком. Всё с CHANGE_ME — обязательно.
# Реальные секреты генерирует и хранит тот, кто деплоит.

# --- Домены (заводятся в Dokploy → Domains, здесь — для кросс-ссылок) ----
# Плейсхолдеры: реальные поддомены назначает хостящий на своём сервере.
BACKEND_DOMAIN=api.example.com
FRONTEND_DOMAIN=app.example.com

# --- Секреты (генерируются при деплое, не копировать с dev) --------------
POSTGRES_PASSWORD=CHANGE_ME_db_password
# Например: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_secret

# --- Тюнинг ---------------------------------------------------------------
UVICORN_WORKERS=2
LOG_LEVEL=INFO
